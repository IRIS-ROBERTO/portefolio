# Auto detect text files and perform LF normalization
* text=auto

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text

# Documents
*.pdf binary

# Archives
*.zip binary
*.tar.gz binary
*.rar binary

# Source code
*.ts text
*.tsx text
*.js text
*.jsx text
*.json text
*.css text
*.html text
*.md text
*.yml text
*.yaml text 